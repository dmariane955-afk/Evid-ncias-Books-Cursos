{
  "entities": {
    "Course": {
      "title": "Course",
      "description": "Academic course entity associated with Curitiba or FATEC campus",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "campus": { "type": "string", "enum": ["curitiba", "fatec"] },
        "academicArea": { "type": "string", "enum": ["exatas", "saude", "humanas", "negocios"] },
        "coordinator": { "type": "string" },
        "director": { "type": "string" },
        "period": { "type": "string" },
        "linkedCampus": { "type": "string" },
        "coverImage": { "type": "string" }
      },
      "required": ["id", "name", "campus", "academicArea", "period"]
    },
    "Activity": {
      "title": "Activity",
      "description": "Academic activity or institutional evidence record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "activityType": { "type": "string" },
        "objective": { "type": "string" },
        "complementaryText": { "type": "string" },
        "photos": { "type": "array" },
        "targetCourseIds": { "type": "array" },
        "primaryCampus": { "type": "string" },
        "syncedCampuses": { "type": "array" },
        "isShared": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "date", "activityType", "objective", "targetCourseIds"]
    },
    "Book": {
      "title": "Book",
      "description": "Academic evidence book containing slides for a specific course and campus",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "courseId": { "type": "string" },
        "campus": { "type": "string", "enum": ["curitiba", "fatec"] },
        "courseName": { "type": "string" },
        "academicArea": { "type": "string" },
        "period": { "type": "string" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "status": { "type": "string" },
        "coordinator": { "type": "string" },
        "director": { "type": "string" },
        "updatedAt": { "type": "string" },
        "coverImage": { "type": "string" },
        "slides": { "type": "array" },
        "slideOrder": { "type": "array" },
        "storageVersion": { "type": "number" }
      },
      "required": ["id", "courseId", "campus", "courseName", "period", "title"]
    },
    "BookSlide": {
      "title": "BookSlide",
      "description": "Individual slide belonging to an AcademicBook, stored separately for unlimited book size",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "bookId": { "type": "string" },
        "type": { "type": "string" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "order": { "type": "number" },
        "activityId": { "type": "string" },
        "syncGroupId": { "type": "string" },
        "syncedBookIds": { "type": "array" },
        "isShared": { "type": "boolean" },
        "photos": { "type": "array" },
        "customTextBoxes": { "type": "array" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "bookId", "type", "order"]
    },
    "MediaAsset": {
      "title": "MediaAsset",
      "description": "Content-addressed compressed image asset shared across slides, activities, and courses",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "dataUrl": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "dataUrl"]
    }
  },
  "firestore": {
    "/courses/{courseId}": {
      "schema": "Course",
      "description": "Collection of courses registered on the platform"
    },
    "/activities/{activityId}": {
      "schema": "Activity",
      "description": "Collection of academic activities and evidence"
    },
    "/books/{bookId}": {
      "schema": "Book",
      "description": "Collection of academic books metadata and slide ordering"
    },
    "/book_slides/{slideDocId}": {
      "schema": "BookSlide",
      "description": "Collection of individual slides per book for unlimited slide capacity"
    },
    "/media/{mediaId}": {
      "schema": "MediaAsset",
      "description": "Collection of deduplicated compressed image assets"
    }
  }
}
